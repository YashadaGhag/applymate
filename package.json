{
  "name": "applymate",
  "private": true,
  "version": "0.0.0",
  "description": "A local AI job search tool that finds matching roles, tailors your resume and cover letter, and tracks applications.",
  "author": "Yashada Ghag",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YashadaGhag/applymate.git"
  },
  "bugs": {
    "url": "https://github.com/YashadaGhag/applymate/issues"
  },
  "homepage": "https://github.com/YashadaGhag/applymate#readme",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "server": "node server/index.js",
    "detect:ats": "node server/scraper/detect.js",
    "fetch:jobs": "node server/scraper/fetchJobs.js",
    "filter:jobs": "node server/scraper/filterJobs.js",
    "curate:others": "node server/scraper/curateOthers.js",
    "score:jobs": "node server/ai/runScoring.js",
    "tailor:job": "node server/ai/runTailoring.js",
    "cover:job": "node server/ai/runCoverLetter.js",
    "build:cities": "node server/geo/buildCities.js",
    "list:sources": "node server/scraper/listSources.js",
    "build:roles": "node server/roles/buildRoleTitles.js",
    "dev:scoring-state": "node server/dev/forceScoringState.js",
    "dev:update-state": "node server/dev/forceUpdateState.js",
    "verify:pdf-links": "node server/dev/verifyPdfLinks.js",
    "dev:all": "concurrently -n vite,server -c blue,green \"npm:dev\" \"npm:server\"",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "chromatic": "npx chromatic"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@tiptap/extension-text-align": "^3.31.4",
    "@tiptap/extension-text-style": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "lucide-react": "^1.17.0",
    "mammoth": "^1.13.0",
    "puppeteer-core": "^25.14.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.17.0",
    "sanitize-html": "^2.18.0",
    "tailwind-merge": "^3.6.0",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.4.0",
    "@storybook/addon-docs": "^10.4.0",
    "@storybook/react-vite": "^10.4.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "chromatic": "^17.0.0",
    "concurrently": "^10.0.5",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-storybook": "^10.4.0",
    "globals": "^17.6.0",
    "playwright": "^1.60.0",
    "postcss": "^8.5.14",
    "prop-types": "^15.8.1",
    "storybook": "^10.4.0",
    "tailwindcss": "^4.3.0",
    "vite": "^8.0.12"
  }
}
