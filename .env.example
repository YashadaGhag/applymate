# Copy this file to .env and fill in the three required keys. Never commit .env.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# ANTHROPIC_API_KEY: server-side only, never prefix with VITE_. Get one at platform.claude.com
# (Settings > API Keys). It runs resume reading, job scoring, resume tailoring and cover letters.
# Without it the app starts, but every AI step fails (a resume can't be read, nothing gets scored).
ANTHROPIC_API_KEY=sk-ant-your_key_here

# LOGO_DEV_SECRET_KEY: server-side only (server/routes/companies.js), never prefix with VITE_ (that
# would put it in the browser bundle). Powers company search on the watchlist. Free: the Logo.dev
# Community plan.
# Without it, company search shows "Company search isn't set up" and you can't add companies by
# search; the API also prints a line about it at startup. Add the key and restart the API.
LOGO_DEV_SECRET_KEY=sk_your_secret_key_here

# VITE_LOGO_DEV_PUBLISHABLE_KEY: read by the browser (src/utils/logo.js) to build company logo URLs.
# The VITE_ prefix is required for Vite to include it, and Logo.dev documents this key as safe to
# expose. Free, from the same Logo.dev account. Without it, company logos don't load and initials
# show instead; everything else works.
VITE_LOGO_DEV_PUBLISHABLE_KEY=pk_your_publishable_key_here

# NOTE for forks: you need your own Logo.dev account and keys, they are not transferable. The free
# tier doesn't require attribution for personal, non-commercial use; any commercial use needs
# attribution per Logo.dev's terms (https://www.logo.dev/docs/platform/attribution). Logo images are
# never downloaded or stored, URLs are built at render time only.

# ---------------------------------------------------------------------------
# Optional (leave commented out to use the default)
# ---------------------------------------------------------------------------

# PORT: the port the local API listens on. Default 3001. If you change it, the Vite proxy in
# vite.config.js must point at the same port.
# PORT=3001

# CHROME_PATH: full path to a Chrome, Edge or Chromium executable, used to make the PDFs behind
# "Download Files". Without it, ApplyMate looks in the usual install locations for Chrome, then
# Microsoft Edge, then Chromium; if none is found, PDF download fails with a clear message.
# No browser is downloaded.
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# APPLYMATE_SCHEDULER: the API updates jobs by itself (scrape, then scoring) after each 9:00 AM
# Pacific while it is running, and checks new watchlist companies in the background. Set to "off"
# (or 0 or false) to turn all of that off. Without this variable the scheduler is on, and scoring
# makes real Anthropic calls (at most 150 per run).
# APPLYMATE_SCHEDULER=off

# APPLYMATE_DATA_DIR: folder for the local data store (resume, jobs, scores, applications).
# Without it, data is kept in ./data in the project folder. The tests set it to a temp folder.
# APPLYMATE_DATA_DIR=

# CHROMATIC_PROJECT_TOKEN: only for `npm run chromatic` (Storybook visual review). The Chromatic CLI
# reads it from the environment itself. Without it, that script can't publish; nothing else is
# affected. Never put the token in package.json or any tracked file.
# CHROMATIC_PROJECT_TOKEN=chpt_your_token_here
